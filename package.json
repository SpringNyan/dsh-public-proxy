{
  "name": "dsh-public-proxy",
  "version": "0.2.0",
  "description": "A DeepSeek Harness plugin that exposes the DSH Web UI for LAN access",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "proxy",
    "lan"
  ],
  "author": "SpringNyan <springnyan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpringNyan/dsh-public-proxy.git"
  },
  "homepage": "https://github.com/SpringNyan/dsh-public-proxy#readme",
  "bugs": {
    "url": "https://github.com/SpringNyan/dsh-public-proxy/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "pnpm run build",
    "build": "rimraf lib && tsc",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.8"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "cookie": "^2.0.1",
    "httpxy": "^0.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
