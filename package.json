{
  "name": "dsh-public-proxy",
  "version": "0.5.0",
  "description": "A LAN proxy plugin for the DeepSeek Harness Web UI with optional access key authentication",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "proxy",
    "lan"
  ],
  "author": "SpringNyan <springnyan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpringNyan/dsh-public-proxy.git"
  },
  "homepage": "https://github.com/SpringNyan/dsh-public-proxy#readme",
  "bugs": {
    "url": "https://github.com/SpringNyan/dsh-public-proxy/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "scripts": {
    "prepare": "pnpm run build",
    "build": "rimraf lib && tsc",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "cookie": "^2.0.2",
    "httpxy": "^0.5.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
